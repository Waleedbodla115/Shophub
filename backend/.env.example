PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shophub
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=ShopHub Admin
ADMIN_EMAIL=admin@shophub.local
ADMIN_PASSWORD=ChangeMe123!
FRONTEND_URL=http://127.0.0.1:5500

# Stripe (optional online payments)
# Leave empty to keep COD-only checkout. Paste a real key from
# https://dashboard.stripe.com/test/apikeys (starts with sk_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI shopping assistant "Shoppy" runs on local Ollama — no API key needed.
# Make sure Ollama is running locally and the model is pulled:
#   ollama pull llama3.2
#   ollama serve
